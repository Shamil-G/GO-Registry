# Пример .env для GO-Registry. Скопируйте в .env и подставьте реальные
# значения (реальный .env — вне git, см. .gitignore).
#
# Секретов здесь быть НЕ должно: этот файл отслеживается git-ом.

# GENERAL
LANGUAGE=ru
SRC_LANG=file
IDLE_TIME=14400

# Уровень логирования
PROD_LOG_LEVEL=INFO
DEV_LOG_LEVEL=DEBUG

# Сервер и порт для разработки и продакшена.
#
# ВАЖНО. На проде PROD_SERVER_ADDR должен быть 127.0.0.1: наружу сервис
# выставляет nginx на том же сервере, он же ставит X-Forwarded-For. Это граница
# безопасности, а не вкусовщина: личность пользователя определяется по IP
# (сессия в SSO привязана к адресу). Если сервис слушает сетевой адрес, до
# него можно достучаться мимо nginx и прислать любой X-Forwarded-For — то есть
# представиться кем угодно. См. middleware/client_ip.go.
PROD_SERVER_ADDR=127.0.0.1
DEV_SERVER_ADDR=127.0.0.1
DEVELOP_PORT=8080
PROD_PORT=9001

# REDIS
REDIS_ADDR=192.168.20.33:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# SSO
PROD_SSO_SERVER=192.168.1.34:8825
DEV_SSO_SERVER=192.168.1.34:8825

# Список endpoints которые не проходят авторизацию
PUBLIC_PATHS=/,/login,/bd,/static/,/language/,/theme/
LOGIN_PAGE=/login

# Внешние адреса портала (как их видит браузер), через запятую. Нужны
# web.RequireSameOrigin, если перед сервисом стоит обратный прокси, который
# переписывает Host на адрес апстрима и не ставит X-Forwarded-Host.
# Пусто — сравниваем только с Host/X-Forwarded-Host.
PUBLIC_HOSTS=192.168.1.34:80

# Адреса, чьим заголовкам X-Forwarded-For / X-Real-IP можно верить (через
# запятую). Заменяет список по умолчанию [127.0.0.1 ::1] целиком, а не
# дополняет. Заполнять, только если nginx стоит НЕ на этой же машине.
# Корпоративный прокси (192.168.1.12) сюда НЕ вписывать: его адрес — часть
# ключа сессии "клиент, прокси", а не тот, чьим заголовкам мы верим.
TRUSTED_PROXIES=127.0.0.1,::1

# Руководители — должности, дающие права руководителя (через запятую)
Boss=Директор,Руководитель,И.о. директора,Заместитель директора,Управляющий директор

# ApproveAdmins — список ФИО супер-администраторов с абсолютными правами
ApproveAdmins=Фамилия Имя Отчество,

# Департаменты, чьи сотрудники считаются HR
HR_DEPARTMENT=Департамент информационных технологий и технического обеспечения,Департамент управления персоналом

# Tester — подмена личности для отладки в dev-режиме. На проде НЕ заполнять.
TESTER_LOGIN_NAME=
TESTER_TOP_LEVEL=2
TESTER_TOP_VIEW=0

# ORACLE
DB_SERVER=192.168.20.60:1521
DB_USER=registry
DB_PASSWORD=CHANGE_ME
DB_SERVICE=gfssdb.gfss.kz

# PhoneBook
PHONE_BOOK=static/nsi/PhoneRefer.pdf

# Департаменты службы безопасности (через запятую). СБ ведёт свой список
# отсутствий (/secure-time-off) и следит, кто и когда приходит на работу.
# Пусто — раздел доступен только супер-администраторам из ApproveAdmins.
SECURITY_DEPARTMENT=Служба по обеспечению безопасности

# Кому отдавать /metrics (через запятую). Prometheus скребёт портал через
# nginx, поэтому здесь нужен адрес, С КОТОРОГО он приходит, а не адрес
# цели из prometeus.yml. Не знаете его — оставьте пусто, зайдите на
# /metrics и посмотрите свой адрес в ответе (сервис его показывает).
# Пусто — доступ всем, как было раньше.
METRICS_ALLOWED_IPS=
